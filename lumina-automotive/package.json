{
  "name": "lumina-automotive",
  "version": "1.0.0",
  "scripts": {
    "start": "node server/index.js",
    "client": "npm start --prefix client",
    "server": "nodemon server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "nodemon": "^3.0.1"
  }
}